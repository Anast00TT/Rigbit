; Engine configuration file.
config_version=5

[application]

config/name="Rigbit"
config/description="Скелетная 2D-анимация на телефоне"
config/version="0.0.1"
run/main_scene="res://ui/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true
config/icon="res://icon.svg"
config/quit_on_go_back=false

[display]

window/size/viewport_width=400
window/size/viewport_height=860
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://locale/strings.ru.translation", "res://locale/strings.en.translation")
locale/fallback="ru"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.086, 0.086, 0.086, 1)
